# Application
DATABASE_URL=
TOKEN_KEY=
FRONTEND_URL=
# Secret used by the daily Vercel cron request that stores dashboard snapshots.
CRON_SECRET=
TIME_ZONE=Africa/Cairo

# Google sign-in
GOOGLE_CLIENT_ID=

# WhatsApp Cloud API / Meta
# Used for WhatsApp registration lookup, webhooks, and the existing project messages.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
# الرقم الفعلي لرقم WhatsApp Business بصيغة دولية، مثال: 201012345678
# يُستخدم فقط لفتح محادثة WhatsApp الجاهزة لإرسال مرفقات المشروع.
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=
# أسماء قوالب Meta المعتمدة. القيم الافتراضية في الكود هي نفس الأسماء أدناه.
WHATSAPP_TEMPLATE_LANGUAGE=ar_EG
WHATSAPP_TEMPLATE_NEW_PROJECT_ASSIGNED=new_project_assigned
WHATSAPP_TEMPLATE_PROJECT_UPDATED_REVIEW=project_updated_review
WHATSAPP_TEMPLATE_PROJECT_COMPLETED_PREVIEW=project_completed_preview
WHATSAPP_TEMPLATE_EXECUTION_PDF_REQUESTED=execution_pdf_requested
WHATSAPP_TEMPLATE_EXECUTION_PDF_COMPLETED=execution_pdf_completed
WHATSAPP_TEMPLATE_EXECUTION_CONFIRMED=execution_confirmed
WHATSAPP_TEMPLATE_PANEL_FILES_READY=panel_files_ready
WHATSAPP_TEMPLATE_PRODUCTION_STAGE_CHECK=production_stage_check

# Google Drive connection (media storage)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
